{
  "name": "@shivnathtathe/openbridge-mcp",
  "version": "2.0.1",
  "description": "Local MCP messaging between OpenCode and Claude Code sessions",
  "type": "module",
  "license": "UNLICENSED",
  "author": {
    "name": "shivnathtathe",
    "email": "sptathe2001@gmail.com"
  },
